<Window x:Class="Notes.EditNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notes"
        mc:Ignorable="d"
        ResizeMode="CanMinimize" Height="500" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleBlock" Style="{StaticResource TitleBlock}" Margin="20" MaxWidth="300"/>

        <StackPanel Grid.Row="1" Margin="20 0" MaxWidth="300">
            <TextBlock Text="Название" Margin="0 0 0 5"/>
            <TextBox x:Name="TitleBox" Height="25" Margin="0 0 0 15"/>
            <TextBlock Text="Описание" Margin="0 0 0 5"/>
            <TextBox x:Name="DescriptionBox" Height="230" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Grid.Row="2" x:Name="Confirm" Click="Confirm_Click" Margin="0 0 30 0" Padding="10 5"/>
            <Button Grid.Row="2" x:Name="Cancel" Click="Cancel_Click" Content="Отмена" Padding="10 5"/>
        </StackPanel>
    </Grid>
</Window>

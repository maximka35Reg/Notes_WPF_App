<Window x:Class="Notes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notes"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="Заметки" Height="800" Width="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitleBlock}" Text="ЗАМЕТКИ" HorizontalAlignment="Center" Margin="10 20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20 0">
            <TextBox x:Name="Search" Margin="0 0 80 0" TextChanged="Search_TextChanged" Background="#f1f3f5"  Foreground="#252525" Height="30" FontSize="16" Padding="3" Width="300"/>
            <ComboBox x:Name="DateSort" Margin="0 0 20 0" SelectionChanged="DateSort_SelectionChanged" MinWidth="200" Height="30">
                <ComboBoxItem Content="Все даты"/>
                <ComboBoxItem Content="Более ранние" />
                <ComboBoxItem Content="Более поздние" />
            </ComboBox>
            <Button Padding="8 3" Content="+" Name="AddBtn" Click="AddBtn_Click" />
        </StackPanel>


        <ListView Grid.Row="2" x:Name="NotesLV" KeyDown="NotesLV_KeyDown" MouseDoubleClick="NotesLV_MouseDoubleClick" HorizontalContentAlignment="Stretch" Margin="20">
            <ListView.ItemTemplate>
            <DataTemplate>
                <Border BorderThickness="2" BorderBrush="Chocolate" Margin="5">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding title}" Padding="20 20 10 10" FontWeight="Bold"/>
                        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical">
                                <TextBlock Text="{Binding description}" TextWrapping="Wrap" MaxWidth="400" Padding="20 10" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding created_at}" FontStyle="Italic" Padding="20 5"/>
                        </StackPanel>

                        <Button Grid.Column="1" Grid.RowSpan="1"  Margin="20 10" x:Name="DeleteBtn" Click="DeleteBtn_Click" Content="Удалить" Padding="5"/>
                    </Grid>
                </Border>
            </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
